{% extends 'base.html.twig' %}

{% block title %}Covoiturage{% endblock %}

{% block body %}
    {% include "/search/index.html.twig" %}
    {% include "/search/filtres.html.twig" %}
    
    {% for covoiturage in covoiturages %}
    <div class="card rounded-pill p-3 covoiturage mt-3 mb-3 ms-5 me-5">
        <div class="row g-0">
          <div class="col-4 text-center">
            <div class="rounded-circle">
              <img class="rounded-circle bg-success" src="{{ path('user_photo', { id: covoiturage.getUser().id }) }}" alt="image utilisateur"  width="100" height="100">
            </div>
            <div class="text-center">
              <img src="/media/star-fill.svg" alt="star avis">
              <p class="text-light">{{covoiturage.getUser().getNote()}}</p>
            </div>
            <p class="card-text text-light">{{covoiturage.getUser().getPseudo()}}</p>
          </div>
          <div class="col-8">
            <div class="card-body">
                <h5 class="text-light m-3">{{covoiturage.getDateDepart()|date('l d F')}}</h5>
                <div class="d-flex">
                    <h5 class="card-title text-light">{{covoiturage.getLieuDepart()}}</h5>
                    <img src="/media/arrow-right.svg" class="rounded-circle me-3 ms-4" alt="flèche">
                    <h5 class="card-title text-light">{{covoiturage.getLieuArrivee()}}</h5>
                </div>
                <div class="d-flex justify-content-between">
                    <h2 class="card-text text-light">{{covoiturage.getPrixPersonne()}} Crédits</h2>
                    <br>
                    <a href="result/{{covoiturage.getId()}}/details"><img src="/media/arrow-down-right-circle-fill.svg" alt="Détails"></a>
                </div>
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
{% endblock body %}