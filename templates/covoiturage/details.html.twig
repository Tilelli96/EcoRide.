{% extends 'base.html.twig' %}

{% block title %}Details{% endblock title %}

{% block body %}
    <div class="m-5 d-md-flex justify-content-around detail">
        <div class="text-center col-md-3">
            <div class="m-3 text-center">
                <img class="rounded-circle bg-success" src="{{ path('user_photo', { id: covoiturage.getUser().id }) }}" alt="image utilisateur"  width="100" height="100">
            </div>
            <div class="text-light text-center m-3">
                <div class="fontVert fs-2">
                    {{covoiturage.getUser().getPseudo()}}
                </div>
                <div class="text-center">
                    <img src="/media/star-fill.svg" alt="star avis">
                    <p class="text-light">{{covoiturage.getUser().getNote()}}</p>
                  </div>
                <div class="">
                    <a href="/avis/{{covoiturage.getUser().getId()}}/index" class="text-small fontVert">avis</a>
                </div>
                <div class="mt-2 text-light fs-1">
                    {{covoiturage.getPrixPersonne()}} Crédits
                </div>   
            </div>
        </div>
        <div class="col-md-5 text-center">
            <div class="text-light">
                <h2>{{covoiturage.getDateDepart()|date('l d F')}}</h2>
            </div>
            <div class="d-flex justify-content-center m-3 mt-5">
                <div>
                    <div class="text-light me-5">
                        <h4>{{covoiturage.getLieuDepart()}}</h4>
                    </div>
                    <div class="text-light">
                        <p>{{covoiturage.getHeureDepart()|date('H:i')}}</p>
                    </div>
                </div>
                <img src="/media/arrow-right.svg" class="m-3 mt-0" alt="flèche">
                <div>
                    <div class="text-light ms-5">
                        <h4>{{covoiturage.getLieuArrivee()}}</h4>
                    </div>
                    <div class="text-light ms-5">
                        <p>{{covoiturage.getHeureArrivee()|date('H:i')}}</p>
                    </div>
                </div>
            </div>
            <div class="m-2 rounded-fill">
                <a href="/covoiturage/{{covoiturage.getId()}}/participer" alt="lien pour participer" class="col-6 btn participer p-2 text-light" onclick="return(confirm('Etes-vous sûr de vouloir dépenser {{covoiturage.getPrixPersonne()}} ?'));">Participer</a>
            </div>
        </div>
        <div class="col-md-3 text-center">
            <div class="m-3 text-center">
                <img src="/media/car.svg" alt="voiture_icone" width="90" height="90">
            </div>
            <div class="m-3 text-center text-light">
                {{covoiturage.getVoiture().marque}}
            </div>
            <div class="m-3 text-center text-light">
                {{covoiturage.getVoiture().getModel()}}
            </div>
            <div class="m-3 text-center fontVert">
                Energie {{covoiturage.getVoiture().getEnergie()}}
            </div>
        </div>
    </div>
    <div class="m-5 p-3 detail d-md-flex">
        <div class="col-md-2"><h4 class="text-light m-3">Preferences :</h4></div>
        <div>
        {% if preferences is defined and preferences is not null %}
            {% if preferences.musique %}
                <p class="text-light m-3">Musique autorisée</p>
            {% endif %}
            {% if preferences.climatisation %}
                <p class="text-light m-3">Climatisation activée</p>
            {% endif %}
            {% if preferences.animauxAcceptes %}
                <p class="text-light m-3">Animaux acceptés</p>
            {% endif %}

            {% if preferences.autresPreferences is defined %}
                {% for pref in preferences.autresPreferences %}
                    <p class="text-light m-3">{{ pref }}</p>
                {% endfor %}
            {% endif %}
        {% endif %}
        </div>
    </div>
    <div class="m-5 d-md-flex text-center detail">
        <h4 class="text-light m-3">Participants</h4>
        {% for covoit in covoiturage.getVoyageurs() %}
            <div class="m-3 p-2">
                <img class="p-3 rounded-circle bg-success opacity-50" src="/media/person.svg" width="90" height="90" alt="image utilisateur">
                {{covoit.getPseudo()}}
            </div>
        {% endfor %}
    </div>
{% endblock %}